@model CampusConnect.Models.FacultyProfile
@{
    var isAdmin = User.IsInRole("Admin");
    var isHod = User.IsInRole("Hod");
    var portalTitle = isAdmin ? "Administrator Profile & Operations Hub" : (isHod ? "Head of Department Profile & Academic Hub" : "Faculty Profile & Academic Portal");
    ViewData["Title"] = portalTitle;
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="cc-badge @(isAdmin ? "cc-badge-danger" : (isHod ? "cc-badge-warning" : "cc-badge-purple"))">
                    <i class="fa-solid @(isAdmin ? "fa-shield-halved" : (isHod ? "fa-landmark" : "fa-chalkboard-user"))"></i>
                    @(isAdmin ? "Admin" : (isHod ? "HOD" : "Faculty")) Portal
                </span>
                <span class="text-muted small">• @User.Identity?.Name</span>
            </div>
            <h2 class="fw-bold mb-0">@portalTitle</h2>
            <p class="text-muted mb-0">Welcome, @Model.Designation! Manage your institutional profile and campus modules.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" class="cc-btn cc-btn-outline">
                <i class="fa-solid fa-user-pen"></i> Edit Profile
            </a>
            @if (isAdmin || isHod)
            {
                <a asp-controller="Hod" asp-action="Dashboard" class="cc-btn cc-btn-secondary">
                    <i class="fa-solid fa-gauge-high"></i> Administrative Portal
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Profile Card -->
    <div class="col-lg-4">
        <div class="cc-card">
            <div class="cc-card-header">
                <h5 class="cc-card-title">
                    <i class="fa-solid fa-id-card text-primary me-2"></i> Profile Details
                </h5>
                <span class="cc-badge cc-badge-success">Verified</span>
            </div>
            <div class="cc-card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 64px; height: 64px;">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">@Model.Designation</h5>
                        <small class="text-muted d-block">@User.Identity?.Name</small>
                        <span class="cc-badge cc-badge-purple mt-1">@Model.Department?.DepartmentCode - @Model.Department?.DepartmentName</span>
                    </div>
                </div>

                <div class="list-group list-group-flush border-top border-bottom mb-4">
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="fa-solid fa-building-columns me-2 text-primary"></i> Department</span>
                        <span class="fw-semibold text-dark">@(Model.Department?.DepartmentName ?? "General Campus")</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="fa-solid fa-briefcase me-2 text-primary"></i> Designation</span>
                        <span class="fw-semibold text-dark">@Model.Designation</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-3 d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="fa-solid fa-door-open me-2 text-primary"></i> Cabin / Office</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.CabinNumber) ? "Not Assigned" : Model.CabinNumber)</span>
                    </div>
                </div>

                <a asp-action="Edit" class="cc-btn cc-btn-outline w-100">
                    <i class="fa-solid fa-pencil"></i> Update Profile Credentials
                </a>
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Action Cards -->
    <div class="col-lg-8">
        <div class="cc-card mb-4">
            <div class="cc-card-header">
                <h5 class="cc-card-title">
                    <i class="fa-solid fa-bolt text-warning me-2"></i> Faculty & Organizer Modules
                </h5>
                <span class="cc-badge cc-badge-secondary">Active Services</span>
            </div>
            <div class="cc-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="metric-icon indigo" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-plus"></i>
                                </div>
                                <h6 class="fw-bold mb-0">Post Opportunity</h6>
                            </div>
                            <p class="text-muted small flex-grow-1">Publish new internships, workshops, research projects, or hackathons.</p>
                            <a asp-controller="Opportunities" asp-action="Create" class="cc-btn w-100 mt-2">
                                Create Listing <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="metric-icon purple" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-chart-line"></i>
                                </div>
                                <h6 class="fw-bold mb-0">Organizer Suite</h6>
                            </div>
                            <p class="text-muted small flex-grow-1">Track your listings, review applicants, update statuses, and export CSV reports.</p>
                            <a asp-controller="Organizer" asp-action="Dashboard" class="cc-btn cc-btn-secondary w-100 mt-2">
                                Open Organizer Hub <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="metric-icon emerald" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-calendar-check"></i>
                                </div>
                                <h6 class="fw-bold mb-0">Office Hours</h6>
                            </div>
                            <p class="text-muted small flex-grow-1">Schedule and manage academic office hour slots and student bookings.</p>
                            <a asp-controller="OfficeHours" asp-action="Index" class="cc-btn cc-btn-outline w-100 mt-2">
                                Manage Office Hours <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="metric-icon amber" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    <i class="fa-solid fa-scale-balanced"></i>
                                </div>
                                <h6 class="fw-bold mb-0">Grievance Desk</h6>
                            </div>
                            <p class="text-muted small flex-grow-1">Review assigned campus grievances, update resolution notes, and track SLAs.</p>
                            <a asp-controller="Grievances" asp-action="OfficerDashboard" class="cc-btn cc-btn-outline w-100 mt-2">
                                Grievance Desk <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (isAdmin || isHod)
        {
            <div class="cc-card">
                <div class="cc-card-header">
                    <h5 class="cc-card-title">
                        <i class="fa-solid fa-shield-halved text-danger me-2"></i> Administrative Governance
                    </h5>
                    <span class="cc-badge cc-badge-danger">Privileged Access</span>
                </div>
                <div class="cc-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <a asp-controller="Opportunities" asp-action="PendingApprovals" class="p-3 bg-light rounded-3 border text-decoration-none d-block h-100 transition-all hover-shadow">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <i class="fa-solid fa-clipboard-check text-warning fa-xl"></i>
                                    <span class="cc-badge cc-badge-warning">Review</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Opportunity Approvals</h6>
                                <small class="text-muted">Review pending listings</small>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Departments" asp-action="Index" class="p-3 bg-light rounded-3 border text-decoration-none d-block h-100 transition-all hover-shadow">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <i class="fa-solid fa-building-columns text-primary fa-xl"></i>
                                    <span class="cc-badge cc-badge-info">Manage</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Departments</h6>
                                <small class="text-muted">Academic departments</small>
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Skills" asp-action="Index" class="p-3 bg-light rounded-3 border text-decoration-none d-block h-100 transition-all hover-shadow">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <i class="fa-solid fa-lightbulb text-warning fa-xl"></i>
                                    <span class="cc-badge cc-badge-purple">Registry</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Skills Registry</h6>
                                <small class="text-muted">Curate skills database</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
