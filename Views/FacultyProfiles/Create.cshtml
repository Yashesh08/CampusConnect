@model CampusConnect.Models.ViewModels.FacultyProfileViewModel
@{
    var isAdmin = User.IsInRole("Admin");
    var title = isAdmin ? "Complete Administrator Profile" : "Complete Faculty Profile";
    ViewData["Title"] = title;
}

<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="cc-badge @(isAdmin ? "cc-badge-danger" : "cc-badge-purple")">
                    <i class="fa-solid @(isAdmin ? "fa-shield-halved" : "fa-id-badge")"></i> Onboarding
                </span>
                <span class="text-muted small">• @User.Identity?.Name</span>
            </div>
            <h2 class="fw-bold mb-0">@title</h2>
            <p class="text-muted mb-0">Initialize your academic profile to enable institutional services and department directory listings.</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="cc-card">
            <div class="cc-card-header">
                <h5 class="cc-card-title">
                    <i class="fa-solid fa-id-card text-primary me-2"></i> Initial Profile Setup
                </h5>
                <span class="cc-badge cc-badge-success">Institutional Record</span>
            </div>
            <div class="cc-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="cc-form-label">Affiliated Department</label>
                        <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Designation" class="cc-form-label">Academic / Administrative Designation</label>
                        <input asp-for="Designation" class="form-control" placeholder="e.g. Associate Professor / System Administrator" />
                        <span asp-validation-for="Designation" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CabinNumber" class="cc-form-label">Cabin / Office Room Number</label>
                        <input asp-for="CabinNumber" class="form-control" placeholder="e.g. CS-204 / Admin-HQ" />
                        <span asp-validation-for="CabinNumber" class="text-danger small"></span>
                    </div>

                    <div class="pt-3 border-top text-end">
                        <button type="submit" class="cc-btn px-4">
                            <i class="fa-solid fa-check me-1"></i> Save Profile & Proceed
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
