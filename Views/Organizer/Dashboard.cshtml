@model IEnumerable<CampusConnect.Models.Opportunity>

@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Organizer Dashboard</h2>
        <p class="text-muted mb-0">Manage your posted campus opportunities and view applicant submissions.</p>
    </div>
    <a asp-controller="Opportunities" asp-action="Create" class="btn btn-primary shadow-sm">+ Post New Opportunity</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 bg-light rounded-3 border">
        <h4 class="text-muted fw-normal">You haven't posted any opportunities yet.</h4>
        <p class="text-muted mb-3">Create your first event, research assistantship, or internship position!</p>
        <a asp-controller="Opportunities" asp-action="Create" class="btn btn-primary">Post Opportunity</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        <div class="col">
            <div class="card border-0 shadow-sm p-3 bg-primary text-white">
                <small class="text-white-50">Total Posted Opportunities</small>
                <h3 class="fw-bold mb-0">@Model.Count()</h3>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm p-3 bg-success text-white">
                <small class="text-white-50">Active / Approved</small>
                <h3 class="fw-bold mb-0">@Model.Count(o => o.ApprovalStatus == CampusConnect.Models.Enums.ApprovalStatus.Approved)</h3>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm p-3 bg-warning text-dark">
                <small class="text-dark-50">Total Applicants Received</small>
                <h3 class="fw-bold mb-0">@Model.Sum(o => o.Applications?.Count ?? 0)</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">My Opportunities</h5>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title & Details</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Deadline</th>
                        <th>Applicants</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opp in Model)
                    {
                        var applicantCount = opp.Applications?.Count ?? 0;
                        <tr>
                            <td>
                                <strong>@opp.Title</strong>
                                <br />
                                <small class="text-muted">@(opp.TargetDepartment?.DepartmentName ?? "All Departments") &bull; @opp.WorkMode</small>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@opp.Category</span></td>
                            <td>
                                @switch (opp.ApprovalStatus)
                                {
                                    case CampusConnect.Models.Enums.ApprovalStatus.Approved:
                                        <span class="badge bg-success px-3 py-1">Published</span>
                                        break;
                                    case CampusConnect.Models.Enums.ApprovalStatus.PendingReview:
                                        <span class="badge bg-warning text-dark px-3 py-1">Pending Approval</span>
                                        break;
                                    case CampusConnect.Models.Enums.ApprovalStatus.Rejected:
                                        <span class="badge bg-danger px-3 py-1">Rejected</span>
                                        break;
                                }
                            </td>
                            <td class="small fw-semibold text-danger">@opp.RegistrationDeadline.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-1 fs-6">@applicantCount</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Applicants" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-primary">
                                        View Applicants (@applicantCount)
                                    </a>
                                    <a asp-action="ExportCsv" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary" title="Export Applicants CSV">
                                        Export CSV
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
