@model CampusConnect.Models.Announcement

@{
    ViewData["Title"] = Model.Title;
    bool isCollege = Model.DepartmentId == null;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Back to Announcements
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 @(isCollege ? "border-start border-4 border-info" : "border-start border-4 border-primary")">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (isCollege)
                {
                    <span class="badge rounded-pill bg-info text-dark px-3 py-1">
                        <i class="fa-solid fa-building-columns me-1"></i> College-Wide Notice
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill bg-primary px-3 py-1">
                        <i class="fa-solid fa-graduation-cap me-1"></i> Department of @(Model.Department?.DepartmentName ?? "Academic")
                    </span>
                }
                <span class="text-muted small">
                    <i class="fa-regular fa-calendar me-1"></i>
                    Published @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm") UTC
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-4">@Model.Title</h2>

            <div class="p-4 bg-light rounded-4 text-dark lh-lg mb-4 border" style="white-space: pre-wrap; font-size: 1rem;">@Model.Content</div>

            <div class="d-flex align-items-center gap-3 pt-3 border-top">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold bg-primary shadow-sm"
                     style="width: 44px; height: 44px;">
                    @(Model.AuthorUser.Email.Length > 0 ? Model.AuthorUser.Email[0].ToString().ToUpper() : "U")
                </div>
                <div>
                    <div class="fw-bold text-dark">@Model.AuthorUser.Email</div>
                    <div class="small text-muted">
                        @(Model.AuthorUser.FacultyProfile?.Designation ?? Model.AuthorUser.Role.ToString())
                        @if (Model.AuthorUser.FacultyProfile?.CabinNumber != null)
                        {
                            <span>· Cabin: @Model.AuthorUser.FacultyProfile.CabinNumber</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
