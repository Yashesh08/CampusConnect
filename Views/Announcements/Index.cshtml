@model CampusConnect.Models.ViewModels.AnnouncementFeedViewModel
@using CampusConnect.Models.Enums

@{
    ViewData["Title"] = "Campus Announcements";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isPrivileged = User.IsInRole("Hod") || User.IsInRole("Admin");
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="fa-solid fa-bullhorn text-primary me-2"></i> Campus Announcements
        </h1>
        <p class="text-muted mb-0">Official updates, campus-wide circulars, and departmental notices.</p>
    </div>
    @if (Model.CanPost)
    {
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="fa-solid fa-plus me-1"></i> Post Announcement
        </a>
    }
</div>

<!-- Scope Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a asp-action="Index" class="nav-link rounded-pill px-4 @(Model.SelectedScope == "all" ? "active" : "bg-white text-dark shadow-sm")">
            <i class="fa-solid fa-globe me-1"></i> All Notices
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Index" asp-route-scope="college"
           class="nav-link rounded-pill px-4 @(Model.SelectedScope == "college" ? "active" : "bg-white text-dark shadow-sm")">
            <i class="fa-solid fa-building-columns me-1"></i> College-Wide Only
        </a>
    </li>
    @if (Model.UserDepartmentId.HasValue)
    {
        <li class="nav-item">
            <a asp-action="Index" asp-route-scope="dept"
               class="nav-link rounded-pill px-4 @(Model.SelectedScope == "dept" ? "active" : "bg-white text-dark shadow-sm")">
                <i class="fa-solid fa-graduation-cap me-1"></i> My Department Notices
            </a>
        </li>
    }
</ul>

<!-- Announcements Feed -->
@if (!Model.Announcements.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-newspaper fa-3x text-muted mb-3 opacity-50"></i>
            <h5 class="fw-bold">No Announcements Published</h5>
            <p class="text-muted small mb-0">No circulars have been posted matching this scope yet.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var a in Model.Announcements)
        {
            bool isCollege = a.DepartmentId == null;
            bool canManage = isPrivileged || a.AuthorUserId.ToString() == currentUserId;

            <div class="card border-0 shadow-sm rounded-4 transition-hover overflow-hidden @(isCollege ? "border-start border-4 border-info" : "border-start border-4 border-primary")">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            @if (isCollege)
                            {
                                <span class="badge rounded-pill bg-info text-dark px-3 py-1 fw-bold">
                                    <i class="fa-solid fa-building-columns me-1"></i> College-Wide
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-primary px-3 py-1 fw-bold">
                                    <i class="fa-solid fa-graduation-cap me-1"></i> @(a.Department?.DepartmentCode ?? "Department")
                                </span>
                            }
                            <span class="text-muted small">
                                <i class="fa-regular fa-calendar me-1"></i>
                                @a.CreatedAt.ToString("MMMM dd, yyyy")
                            </span>
                        </div>

                        @if (canManage)
                        {
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@a.AnnouncementId" class="btn btn-outline-secondary btn-sm rounded-3">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@a.AnnouncementId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3"
                                            onclick="return confirm('Delete this announcement?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <h4 class="fw-bold text-dark mb-2">
                        <a asp-action="Details" asp-route-id="@a.AnnouncementId" class="text-decoration-none text-dark">
                            @a.Title
                        </a>
                    </h4>

                    <p class="text-secondary lh-lg mb-3" style="font-size: 0.95rem; white-space: pre-wrap;">@a.Content</p>

                    <div class="d-flex align-items-center gap-2 pt-2 border-top small text-muted">
                        <i class="fa-solid fa-user-circle text-primary"></i>
                        <span>Posted by: <strong>@a.AuthorUser.Email</strong></span>
                        @if (a.AuthorUser.FacultyProfile != null)
                        {
                            <span class="text-secondary">(@a.AuthorUser.FacultyProfile.Designation)</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .transition-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
    }
</style>
