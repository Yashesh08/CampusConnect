@using CampusConnect.Models
@using CampusConnect.Services
@{
    ViewData["Title"] = "Skill Match Simulator";
    var opportunity = ViewBag.Opportunity as Opportunity;
    var matchResult = ViewBag.MatchResult as MatchResult;
    var studentProfile = ViewBag.StudentProfile as StudentProfile;
    var availableOpps = ViewBag.AvailableOpportunities as List<Opportunity> ?? new List<Opportunity>();
    var availableStudents = ViewBag.AvailableStudents as List<StudentProfile> ?? new List<StudentProfile>();
    var isNonStudent = (bool)(ViewBag.IsSimulatorForNonStudent ?? false);
    var pct = matchResult?.MatchPercentage ?? 0;
}

<!-- Page Header -->
<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="cc-badge cc-badge-warning">
                    <i class="fa-solid fa-sliders"></i> Algorithmic Simulator
                </span>
                <span class="text-muted small">• FR-5 Skill Gap Engine</span>
            </div>
            <h2 class="fw-bold mb-0">Skill Match Simulator & Gap Analyzer</h2>
            <p class="text-muted mb-0">Cross-reference candidate skills against opportunity criteria to calculate compatibility scores and skill gaps.</p>
        </div>
        <div>
            <a asp-action="Index" class="cc-btn cc-btn-outline">
                <i class="fa-solid fa-house"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

<!-- Interactive Simulation Control Panel -->
<div class="cc-card mb-4">
    <div class="cc-card-header">
        <h5 class="cc-card-title">
            <i class="fa-solid fa-flask-vial text-primary me-2"></i> Simulation Parameters
        </h5>
        @if (isNonStudent)
        {
            <span class="cc-badge cc-badge-purple">Administrative / Faculty Preview Mode</span>
        }
        else
        {
            <span class="cc-badge cc-badge-success">Student Live Profile Mode</span>
        }
    </div>
    <div class="cc-card-body">
        <form method="get" asp-action="TestEngine" class="row g-3 align-items-end">
            @if (isNonStudent && availableStudents.Any())
            {
                <div class="col-md-5">
                    <label class="cc-form-label">Select Student Candidate</label>
                    <select name="studentProfileId" class="form-select">
                        @foreach (var s in availableStudents)
                        {
                            var isSelected = studentProfile != null && studentProfile.ProfileId == s.ProfileId;
                            <option value="@s.ProfileId" selected="@(isSelected ? "selected" : null)">
                                @(s.User?.Email ?? s.RollNumber) (@(s.Department?.DepartmentCode ?? "GEN") - Roll: @s.RollNumber)
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="@(isNonStudent && availableStudents.Any() ? "col-md-5" : "col-md-9")">
                <label class="cc-form-label">Select Target Opportunity</label>
                <select name="opportunityId" class="form-select">
                    @if (availableOpps.Any())
                    {
                        foreach (var opp in availableOpps)
                        {
                            var isSelected = opportunity != null && opportunity.OpportunityId == opp.OpportunityId;
                            <option value="@opp.OpportunityId" selected="@(isSelected ? "selected" : null)">
                                [@opp.Category] @opp.Title (@opp.RequiredSkills.Count skills required)
                            </option>
                        }
                    }
                    else if (opportunity != null)
                    {
                        <option value="@opportunity.OpportunityId" selected="selected">
                            [@opportunity.Category] @opportunity.Title
                        </option>
                    }
                </select>
            </div>

            <div class="@(isNonStudent && availableStudents.Any() ? "col-md-2" : "col-md-3")">
                <button type="submit" class="cc-btn w-100">
                    <i class="fa-solid fa-play"></i> Run Analysis
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Candidate & Target Listing Overview -->
<div class="row g-4 mb-4">
    <!-- Candidate Profile Info -->
    <div class="col-lg-5">
        <div class="cc-card h-100">
            <div class="cc-card-header">
                <h5 class="cc-card-title">
                    <i class="fa-solid fa-id-card text-primary me-2"></i> Evaluated Candidate
                </h5>
                <span class="cc-badge cc-badge-purple">Profile</span>
            </div>
            <div class="cc-card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 48px; height: 48px;">
                        @(studentProfile?.User?.Email?.Substring(0, 1).ToUpper() ?? "S")
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">@(studentProfile?.User?.Email ?? "Demo Candidate")</h6>
                        <small class="text-muted">Roll: @(string.IsNullOrEmpty(studentProfile?.RollNumber) ? "N/A" : studentProfile.RollNumber)</small>
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block fw-semibold mb-2">Registered Skills (@(studentProfile?.StudentSkills?.Count ?? 0)):</small>
                    @if (studentProfile?.StudentSkills != null && studentProfile.StudentSkills.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var ss in studentProfile.StudentSkills)
                            {
                                <span class="badge bg-light text-dark border">
                                    @ss.Skill.SkillName <small class="text-primary">• @ss.ProficiencyLevel</small>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">No registered skills on this profile.</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Requirements Info -->
    <div class="col-lg-7">
        <div class="cc-card h-100">
            <div class="cc-card-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="cc-badge cc-badge-purple">@opportunity?.Category</span>
                    <h5 class="cc-card-title mb-0">@opportunity?.Title</h5>
                </div>
                <span class="cc-badge cc-badge-info">Target Criteria</span>
            </div>
            <div class="cc-card-body">
                <p class="text-muted small mb-3">@opportunity?.Description</p>
                <div class="mb-2">
                    <small class="text-muted d-block fw-semibold mb-2">Required Skills for Position:</small>
                    @if (opportunity?.RequiredSkills != null && opportunity.RequiredSkills.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var req in opportunity.RequiredSkills)
                            {
                                <span class="skill-chip">
                                    <i class="fa-solid fa-code text-primary me-1"></i> @req.Skill.SkillName
                                    <span class="proficiency-pill intermediate">Required</span>
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">No required skills specified for this opportunity.</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Compatibility Result Card -->
<div class="cc-card mb-4">
    <div class="cc-card-header">
        <h5 class="cc-card-title">
            <i class="fa-solid fa-chart-line text-success me-2"></i> Compatibility & Gap Evaluation
        </h5>
        <span class="cc-badge @(pct >= 80 ? "cc-badge-success" : (pct >= 50 ? "cc-badge-warning" : "cc-badge-danger"))">
            @(pct >= 80 ? "High Compatibility" : (pct >= 50 ? "Moderate Match" : "Significant Gap"))
        </span>
    </div>
    <div class="cc-card-body">
        <div class="row align-items-center mb-4">
            <div class="col-md-4 text-center border-end">
                <div class="match-score-display @(pct >= 80 ? "text-success" : (pct >= 50 ? "text-warning" : "text-danger"))">
                    @pct<span class="fs-4 text-muted">%</span>
                </div>
                <div class="text-muted small fw-semibold mt-1">Algorithmic Compatibility Score</div>
                <div class="mt-2">
                    @if (pct == 100)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                            <i class="fa-solid fa-circle-check me-1"></i> Perfect Candidate Match
                        </span>
                    }
                    else if (pct >= 50)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Qualified with Skill Gaps
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                            <i class="fa-solid fa-circle-xmark me-1"></i> Substantial Skill Gap
                        </span>
                    }
                </div>
            </div>

            <div class="col-md-8 ps-md-4">
                <label class="form-label small fw-semibold text-muted mb-2">Match Progression</label>
                <div class="progress-gradient mb-3" style="height: 16px;">
                    <div class="progress-bar @(pct >= 80 ? "bg-success" : (pct >= 50 ? "bg-warning" : "bg-danger"))" 
                         role="progressbar" 
                         style="width: @pct%" 
                         aria-valuenow="@pct" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                    </div>
                </div>
                <p class="text-muted small mb-0">
                    Calculation formula compares the candidate's verified skills against the required opportunity skills list. Missing skills highlight areas for development or targeted training.
                </p>
            </div>
        </div>

        <div class="row g-4 pt-3 border-top">
            <!-- Matching Skills -->
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <h6 class="fw-bold text-success mb-3">
                        <i class="fa-solid fa-circle-check me-1"></i> Matched Skills (@(matchResult?.MatchingSkills.Count ?? 0))
                    </h6>
                    @if (matchResult?.MatchingSkills != null && matchResult.MatchingSkills.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var skill in matchResult.MatchingSkills)
                            {
                                <div class="p-2 bg-white rounded-2 border d-flex align-items-center justify-content-between">
                                    <span class="fw-semibold text-dark"><i class="fa-solid fa-check text-success me-2"></i> @skill.SkillName</span>
                                    <span class="cc-badge cc-badge-success" style="font-size: 0.7rem;">Verified</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No matching skills found between profile and opportunity requirements.</p>
                    }
                </div>
            </div>

            <!-- Missing Skills (Skill Gap) -->
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <h6 class="fw-bold text-danger mb-3">
                        <i class="fa-solid fa-circle-xmark me-1"></i> Missing Skills (Skill Gap: @(matchResult?.MissingSkills.Count ?? 0))
                    </h6>
                    @if (matchResult?.MissingSkills != null && matchResult.MissingSkills.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var gap in matchResult.MissingSkills)
                            {
                                <div class="p-2 bg-white rounded-2 border d-flex align-items-center justify-content-between">
                                    <span class="fw-semibold text-dark"><i class="fa-solid fa-xmark text-danger me-2"></i> @gap.SkillName</span>
                                    <span class="cc-badge cc-badge-danger" style="font-size: 0.7rem;">Skill Gap</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-success-subtle text-success rounded-3 border border-success-subtle small fw-semibold">
                            <i class="fa-solid fa-award me-1"></i> Candidate possesses all skills specified for this opportunity!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
