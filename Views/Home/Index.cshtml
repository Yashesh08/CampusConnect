@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isLoggedIn = Context.Session.GetString("UserId") != null;
}

<div class="mt-5">
    @if (!isLoggedIn)
    {
        <div class="hero text-center">
            <h1>Welcome to CampusConnect</h1>
            <p class="lead">Connect, collaborate, and grow together</p>
        </div>

        <div class="card-page">
            <h3 class="mb-4">Please login or register to continue</h3>
            <div class="d-flex gap-2">
                <a class="btn btn-primary flex-grow-1" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-outline-primary flex-grow-1" asp-controller="Account" asp-action="Register">Register</a>
            </div>
        </div>
    }
    else
    {
        <div class="hero">
            <h1>Welcome back, @Context.Session.GetString("UserEmail")</h1>
            <p class="lead">Choose what you'd like to explore</p>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card-page text-center h-100">
                    <h5 class="mb-3">🏢 Departments</h5>
                    <p class="text-muted mb-3">Browse and manage departments</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Departments" asp-action="Index">Explore Departments</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-page text-center h-100">
                    <h5 class="mb-3">👤 Student Profiles</h5>
                    <p class="text-muted mb-3">View and edit student profiles</p>
                    <a class="btn btn-primary btn-sm" asp-controller="StudentProfiles" asp-action="Index">Explore Profiles</a>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-page text-center h-100">
                    <h5 class="mb-3">💡 Skills</h5>
                    <p class="text-muted mb-3">Manage skills and competencies</p>
                    <a class="btn btn-primary btn-sm" asp-controller="Skills" asp-action="Index">Explore Skills</a>
                </div>
            </div>
        </div>
    }
</div>
