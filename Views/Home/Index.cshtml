@using Microsoft.AspNetCore.Identity
@using CampusConnect.Models
@using CampusConnect.Models.Enums
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Campus Ecosystem Dashboard";
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    UserRole? userRole = null;
    User? appUser = null;
    if (isLoggedIn)
    {
        appUser = await UserManager.GetUserAsync(User);
        if (appUser != null)
        {
            userRole = appUser.Role;
        }
    }
}

@if (!isLoggedIn)
{
    <!-- Hero Banner for Visitors -->
    <div class="cc-hero">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="cc-badge cc-badge-purple mb-3">
                    <i class="fa-solid fa-sparkles"></i> Campus Ecosystem Connected
                </span>
                <h1>Welcome to CampusConnect</h1>
                <p class="lead">
                    A unified platform for academic departments, grievance redressal, faculty office hours, student profiles, and opportunity skill matching.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="cc-btn" asp-area="Identity" asp-page="/Account/Login">
                        <i class="fa-solid fa-right-to-bracket"></i> Login to Workspace
                    </a>
                    <a class="cc-btn cc-btn-outline text-white border-white" asp-area="Identity" asp-page="/Account/Register">
                        <i class="fa-solid fa-user-plus"></i> Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Metric Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-icon indigo">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div class="metric-details">
                    <div class="metric-label">Opportunities</div>
                    <div class="metric-value">Active Listings</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-icon purple">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div class="metric-details">
                    <div class="metric-label">Student Profiles</div>
                    <div class="metric-value">Enrolled</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-icon amber">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div class="metric-details">
                    <div class="metric-label">Grievance Desk</div>
                    <div class="metric-value">Operational</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="metric-card">
                <div class="metric-icon emerald">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <div class="metric-details">
                    <div class="metric-label">Faculty Directory</div>
                    <div class="metric-value">Connected</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Local Seeding Information Card -->
    <div class="cc-card mb-5">
        <div class="cc-card-header">
            <h5 class="cc-card-title">
                <i class="fa-solid fa-key text-primary me-2"></i> Local Development Pre-seeded Accounts
            </h5>
            <span class="cc-badge cc-badge-success">Seeded Database</span>
        </div>
        <div class="cc-card-body">
            <p class="text-muted mb-4">
                Use any of the following pre-configured dummy user accounts for local testing. All accounts share password:&nbsp;<code class="text-primary fw-bold">Password123!</code>
            </p>

            <!-- System Admin -->
            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size:0.7rem; letter-spacing:0.08em;">
                <i class="fa-solid fa-shield-halved me-1"></i> System Administrator
            </h6>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-borderless align-middle" style="font-size:0.85rem;">
                    <thead class="text-muted" style="font-size:0.75rem;">
                        <tr><th>Email</th><th>Role</th><th>Department</th><th>Note</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>admin@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-danger">Admin</span></td>
                            <td>All Departments</td>
                            <td class="text-muted">Full system access — can approve any department's opportunities</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Department HODs -->
            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size:0.7rem; letter-spacing:0.08em;">
                <i class="fa-solid fa-building-columns me-1"></i> Department HODs — Approval Authority (Own Dept Only)
            </h6>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-borderless align-middle" style="font-size:0.85rem;">
                    <thead class="text-muted" style="font-size:0.75rem;">
                        <tr><th>Email</th><th>Role</th><th>Department</th><th>Can Approve</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>hod.cse@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-warning">HOD</span></td>
                            <td>Computer Engineering</td>
                            <td class="text-muted">CSE opportunities only</td>
                        </tr>
                        <tr>
                            <td><code>hod.ee@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-warning">HOD</span></td>
                            <td>Electrical Engineering</td>
                            <td class="text-muted">EE opportunities only</td>
                        </tr>
                        <tr>
                            <td><code>hod.it@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-warning">HOD</span></td>
                            <td>Information Technology</td>
                            <td class="text-muted">IT opportunities only</td>
                        </tr>
                        <tr>
                            <td><code>hod.ce@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-warning">HOD</span></td>
                            <td>Civil Engineering</td>
                            <td class="text-muted">CE opportunities only</td>
                        </tr>
                        <tr>
                            <td><code>hod.me@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-warning">HOD</span></td>
                            <td>Mechanical Engineering</td>
                            <td class="text-muted">ME opportunities only (try approving Opp 5!)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Faculty -->
            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size:0.7rem; letter-spacing:0.08em;">
                <i class="fa-solid fa-chalkboard-user me-1"></i> Faculty (Organizers)
            </h6>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-borderless align-middle" style="font-size:0.85rem;">
                    <thead class="text-muted" style="font-size:0.75rem;">
                        <tr><th>Email</th><th>Role</th><th>Department</th><th>Note</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>faculty.smith@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-purple">Faculty</span></td>
                            <td>Computer Engineering</td>
                            <td class="text-muted">Owns all 5 seeded opportunities (Organizer)</td>
                        </tr>
                        <tr>
                            <td><code>faculty.patel@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-purple">Faculty</span></td>
                            <td>Electrical Engineering</td>
                            <td class="text-muted">EE Faculty — can post new opportunities</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Students -->
            <h6 class="text-uppercase text-muted fw-bold mb-2" style="font-size:0.7rem; letter-spacing:0.08em;">
                <i class="fa-solid fa-graduation-cap me-1"></i> Students (Applicants)
            </h6>
            <div class="table-responsive mb-0">
                <table class="table table-sm table-borderless align-middle mb-0" style="font-size:0.85rem;">
                    <thead class="text-muted" style="font-size:0.75rem;">
                        <tr><th>Email</th><th>Role</th><th>Roll No.</th><th>Department</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>student.alice@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-info">Student</span></td>
                            <td>CS202401</td>
                            <td>Computer Engineering</td>
                        </tr>
                        <tr>
                            <td><code>student.bob@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-info">Student</span></td>
                            <td>CS202402</td>
                            <td>Computer Engineering</td>
                        </tr>
                        <tr>
                            <td><code>student.priya@campusconnect.edu</code></td>
                            <td><span class="cc-badge cc-badge-info">Student</span></td>
                            <td>EE202401</td>
                            <td>Electrical Engineering</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
}
else if (userRole.HasValue)
{
    <!-- Authenticated User Hero Banner -->
    <div class="cc-hero">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="cc-badge cc-badge-purple fs-6 px-3 py-1">
                <i class="fa-solid fa-user-shield"></i> @userRole.Value Portal
            </span>
            <span class="text-white-50">• Signed in as @User.Identity?.Name</span>
        </div>
        <h1>Welcome Back, @User.Identity?.Name</h1>
        <p class="lead">
            Manage your opportunities, applications, academic activities, and campus tools from your personalized dashboard.
        </p>
    </div>

    <!-- Dashboard Quick Action Cards -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    <h5 class="cc-card-title"><i class="fa-solid fa-briefcase text-primary me-2"></i> Opportunities</h5>
                </div>
                <div class="cc-card-body">
                    <p class="text-muted">Discover workshops, internships, research projects, and campus hackathons.</p>
                </div>
                <div class="cc-card-footer">
                    <a class="cc-btn w-100" asp-controller="Opportunities" asp-action="Index">
                        Explore Opportunities <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    <h5 class="cc-card-title"><i class="fa-solid fa-paper-plane text-info me-2"></i> My Applications</h5>
                </div>
                <div class="cc-card-body">
                    <p class="text-muted">Track your submitted opportunity applications, review statuses, and organizer remarks.</p>
                </div>
                <div class="cc-card-footer">
                    <a class="cc-btn cc-btn-outline w-100" asp-controller="Applications" asp-action="MyApplications">
                        View Applications <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    <h5 class="cc-card-title"><i class="fa-solid fa-chart-line text-success me-2"></i> Organizer Dashboard</h5>
                </div>
                <div class="cc-card-body">
                    <p class="text-muted">Manage posted opportunities, review applicants, update statuses, and export CSV reports.</p>
                </div>
                <div class="cc-card-footer">
                    <a class="cc-btn cc-btn-secondary w-100" asp-controller="Organizer" asp-action="Dashboard">
                        Organizer Suite <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    <h5 class="cc-card-title"><i class="fa-solid fa-building-columns text-primary me-2"></i> Departments</h5>
                </div>
                <div class="cc-card-body">
                    <p class="text-muted">Explore academic departments, HOD assignments, and faculty listings.</p>
                </div>
                <div class="cc-card-footer">
                    <a class="cc-btn cc-btn-outline w-100" asp-controller="Departments" asp-action="Index">
                        Browse Departments <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    @if (userRole == UserRole.Student)
                    {
                        <h5 class="cc-card-title"><i class="fa-solid fa-id-card text-purple me-2"></i> My Profile & Skills</h5>
                    }
                    else
                    {
                        <h5 class="cc-card-title"><i class="fa-solid fa-users-viewfinder text-purple me-2"></i> Student Directory</h5>
                    }
                </div>
                <div class="cc-card-body">
                    @if (userRole == UserRole.Student)
                    {
                        <p class="text-muted">Manage your student profile, upload your resume, update social links, and configure your skills.</p>
                    }
                    else
                    {
                        <p class="text-muted">Explore enrolled student profiles, review their technical skills, portfolios, and verified resumes.</p>
                    }
                </div>
                <div class="cc-card-footer">
                    @if (userRole == UserRole.Student)
                    {
                        <a class="cc-btn w-100" asp-controller="StudentProfiles" asp-action="Dashboard">
                            Manage My Profile <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <a class="cc-btn w-100" asp-controller="Directory" asp-action="Index" asp-route-role="Student">
                            Browse Student Profiles <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="cc-card h-100">
                <div class="cc-card-header">
                    <h5 class="cc-card-title"><i class="fa-solid fa-sliders text-warning me-2"></i> Skill Simulator</h5>
                </div>
                <div class="cc-card-body">
                    <p class="text-muted">Test your profile skills against opportunities using the skill matching engine.</p>
                </div>
                <div class="cc-card-footer">
                    <a class="cc-btn w-100" asp-controller="Home" asp-action="TestEngine" style="background: #F59E0B; color: white;">
                        Run Skill Simulator <i class="fa-solid fa-play ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
}
