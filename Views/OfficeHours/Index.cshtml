@model CampusConnect.Models.ViewModels.OfficeHoursIndexViewModel
@using CampusConnect.Models.Enums

@{
    ViewData["Title"] = "Faculty Office Hours";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="fa-solid fa-calendar-check text-success me-2"></i> Faculty Office Hours
        </h1>
        <p class="text-muted mb-0">Schedule 1-on-1 consultations with professors and academic advisors.</p>
    </div>
    @if (Model.IsFaculty)
    {
        <a asp-action="Manage" class="btn btn-primary rounded-3 shadow-sm px-4">
            <i class="fa-solid fa-sliders me-1"></i> Manage My Office Hours
        </a>
    }
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1">Department</label>
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">
                            @d.DepartmentCode - @d.DepartmentName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1">Faculty Member</label>
                <select name="facultyId" class="form-select">
                    <option value="">All Faculty</option>
                    @foreach (var f in Model.FacultyMembers)
                    {
                        <option value="@f.Id" selected="@(Model.SelectedFacultyUserId == f.Id ? "selected" : null)">
                            @f.Email @(f.FacultyProfile != null ? $"({f.FacultyProfile.Designation})" : "")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabs: Available Slots vs My Bookings -->
<ul class="nav nav-pills mb-4 gap-2" role="tablist">
    <li class="nav-item">
        <button class="nav-link active rounded-pill px-4" id="available-tab" data-bs-toggle="pill" data-bs-target="#available" type="button" role="tab">
            <i class="fa-solid fa-calendar-days me-1"></i> Available Slots (@Model.AvailableSlots.Count)
        </button>
    </li>
    @if (Model.IsStudent)
    {
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 @(Model.MyBookedSlots.Any() ? "bg-white text-dark shadow-sm" : "")" id="mybookings-tab" data-bs-toggle="pill" data-bs-target="#mybookings" type="button" role="tab">
                <i class="fa-solid fa-bookmark me-1"></i> My Booked Consultations (@Model.MyBookedSlots.Count)
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    <!-- TAB 1: AVAILABLE SLOTS -->
    <div class="tab-pane fade show active" id="available" role="tabpanel">
        @if (!Model.AvailableSlots.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                <div class="card-body">
                    <i class="fa-solid fa-calendar-xmark fa-3x text-muted mb-3 opacity-50"></i>
                    <h5 class="fw-bold">No Open Office Hours Available</h5>
                    <p class="text-muted small mb-0">Check back later or select a different department/faculty filter.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var slot in Model.AvailableSlots)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-4 transition-hover border-start border-4 border-success">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@slot.FacultyUser.Email</h6>
                                    <div class="small text-muted">
                                        @(slot.FacultyUser.FacultyProfile?.Designation ?? "Faculty") ·
                                        <strong>@(slot.FacultyUser.FacultyProfile?.Department?.DepartmentCode ?? "GEN")</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(slot.FacultyUser.FacultyProfile?.CabinNumber))
                                    {
                                        <div class="small text-secondary mt-1">
                                            <i class="fa-solid fa-door-open me-1 text-muted"></i> Cabin: @slot.FacultyUser.FacultyProfile.CabinNumber
                                        </div>
                                    }
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                    Open
                                </span>
                            </div>

                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                <div class="fw-bold text-dark">
                                    <i class="fa-regular fa-calendar text-primary me-2"></i>
                                    @slot.StartTime.ToString("dddd, MMMM dd, yyyy")
                                </div>
                                <div class="small text-muted mt-1">
                                    <i class="fa-regular fa-clock text-primary me-2"></i>
                                    @slot.StartTime.ToString("hh:mm tt") – @slot.EndTime.ToString("hh:mm tt") UTC
                                </div>
                            </div>

                            <div class="mt-auto">
                                @if (Model.IsStudent)
                                {
                                    <form asp-action="BookSlot" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotId" value="@slot.SlotId" />
                                        <button type="submit" class="btn btn-success w-100 rounded-3">
                                            <i class="fa-solid fa-check me-1"></i> Book This Slot
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Directory" asp-action="Profile" asp-route-id="@slot.FacultyUserId"
                                       class="btn btn-outline-secondary w-100 rounded-3 btn-sm">
                                        View Professor Profile
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- TAB 2: MY BOOKED CONSULTATIONS (STUDENT) -->
    @if (Model.IsStudent)
    {
        <div class="tab-pane fade" id="mybookings" role="tabpanel">
            @if (!Model.MyBookedSlots.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                    <div class="card-body">
                        <i class="fa-solid fa-bookmark fa-3x text-muted mb-3 opacity-50"></i>
                        <h5 class="fw-bold">No Booked Consultations</h5>
                        <p class="text-muted small mb-0">Browse open slots above to schedule office hours with your professors.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var b in Model.MyBookedSlots)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="fw-bold mb-0 text-dark">@b.FacultyUser.Email</h6>
                                    <span class="badge bg-primary px-2 py-1">Confirmed</span>
                                </div>
                                <div class="small text-muted mb-3">
                                    @(b.FacultyUser.FacultyProfile?.Designation ?? "Faculty") ·
                                    Cabin: @(b.FacultyUser.FacultyProfile?.CabinNumber ?? "N/A")
                                </div>

                                <div class="p-3 bg-light rounded-3 mb-3 border">
                                    <div class="fw-bold text-dark">
                                        <i class="fa-regular fa-calendar text-primary me-2"></i>
                                        @b.StartTime.ToString("ddd, MMM dd, yyyy")
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="fa-regular fa-clock text-primary me-2"></i>
                                        @b.StartTime.ToString("hh:mm tt") – @b.EndTime.ToString("hh:mm tt") UTC
                                    </div>
                                </div>

                                <form asp-action="CancelBooking" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="slotId" value="@b.SlotId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-3"
                                            onclick="return confirm('Cancel this appointment?');">
                                        <i class="fa-solid fa-xmark me-1"></i> Cancel Consultation
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08) !important;
    }
</style>
