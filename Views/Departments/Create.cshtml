@model CampusConnect.Models.Department
@{
    ViewData["Title"] = "New Department";
}
<h1 class="h3">New Department</h1>
<form asp-action="Create" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="DepartmentName" />
    </div>
    <div class="mb-3">
        <label class="form-label">Code</label>
        <input class="form-control" asp-for="DepartmentCode" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary ms-2" asp-action="Index">Cancel</a>
</form>
