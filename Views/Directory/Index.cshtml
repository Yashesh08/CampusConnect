@model CampusConnect.Models.ViewModels.DirectoryIndexViewModel
@using CampusConnect.Models.Enums
@using CampusConnect.Models.ViewModels

@{
    ViewData["Title"] = "Campus Directory";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="fa-solid fa-address-book text-primary me-2"></i> Campus Directory
        </h1>
        <p class="text-muted mb-0">Browse and connect with students and faculty members across all departments.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Network" asp-action="Index" class="btn btn-outline-primary rounded-3 shadow-sm">
            <i class="fa-solid fa-user-group me-1"></i> My Network
        </a>
        <a asp-controller="Messages" asp-action="Index" class="btn btn-outline-secondary rounded-3 shadow-sm">
            <i class="fa-solid fa-comments me-1"></i> Messages
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <!-- Search Text -->
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Search Directory</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0"
                           placeholder="Search by name, email, roll no, designation…"
                           value="@Model.SearchQuery" />
                </div>
            </div>

            <!-- Role Filter -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Role</label>
                <select name="role" class="form-select">
                    <option value="">All Roles</option>
                    <option value="Student" selected="@(Model.SelectedRole == "Student" ? "selected" : null)">Students</option>
                    <option value="Faculty" selected="@(Model.SelectedRole == "Faculty" ? "selected" : null)">Faculty</option>
                </select>
            </div>

            <!-- Department Filter -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Department</label>
                <select name="departmentId" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(Model.SelectedDepartmentId == dept.DepartmentId ? "selected" : null)">
                            @dept.DepartmentCode - @dept.DepartmentName
                        </option>
                    }
                </select>
            </div>

            <!-- Skill Filter -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Skill</label>
                <select name="skill" class="form-select">
                    <option value="">All Skills</option>
                    @foreach (var sk in Model.AvailableSkills)
                    {
                        <option value="@sk" selected="@(Model.SelectedSkill == sk ? "selected" : null)">@sk</option>
                    }
                </select>
            </div>

            <!-- Filter Buttons -->
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100 rounded-3" title="Apply Filters">
                    <i class="fa-solid fa-filter"></i>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Clear Filters">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Stats row -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted small">
        Showing <strong>@Model.TotalMembers</strong> campus members
        @if (Model.StudentCount > 0) { <span>(@Model.StudentCount students)</span> }
        @if (Model.FacultyCount > 0) { <span>(@Model.FacultyCount faculty)</span> }
    </div>
</div>

<!-- Directory Cards Grid -->
@if (!Model.Members.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-user-slash fa-3x text-muted mb-3 opacity-50"></i>
            <h5 class="fw-bold">No Directory Profiles Found</h5>
            <p class="text-muted small mb-3">Try adjusting your search criteria or removing filters.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-3">Reset All Filters</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var m in Model.Members)
        {
            bool isStudent = m.Role == UserRole.Student;
            bool isFaculty = m.Role == UserRole.Faculty || m.Role == UserRole.Hod;

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 member-card transition-hover">
                    <div class="card-body p-4 d-flex flex-column">
                        <!-- Card Header: Avatar & Role Badge -->
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                                     style="width: 50px; height: 50px; font-size: 1.2rem; background: @(isStudent ? "linear-gradient(135deg, #3b82f6, #6366f1)" : "linear-gradient(135deg, #10b981, #059669)");">
                                    @(m.Email.Length > 0 ? m.Email[0].ToString().ToUpper() : "U")
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-truncate text-dark" style="max-width: 170px;" title="@m.Email">
                                        @m.Email
                                    </h6>
                                    <div class="small text-muted">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @(m.DepartmentName ?? "General")
                                    </div>
                                </div>
                            </div>
                            <span class="badge rounded-pill @(isStudent ? "bg-primary" : (m.Role == UserRole.Hod ? "bg-danger" : "bg-success")) px-2 py-1">
                                @m.Role
                            </span>
                        </div>

                        <!-- Details Section -->
                        <div class="flex-grow-1 mb-3">
                            @if (isStudent)
                            {
                                @if (!string.IsNullOrEmpty(m.RollNumber))
                                {
                                    <div class="small text-muted mb-1">
                                        <span class="fw-semibold text-dark">Roll:</span> @m.RollNumber
                                        @if (m.BatchYear.HasValue) { <span class="ms-2">· Class of @m.BatchYear</span> }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(m.Bio))
                                {
                                    <p class="small text-secondary mb-2 line-clamp-2" style="font-size: 0.85rem;">
                                        @m.Bio
                                    </p>
                                }
                                @if (m.Skills.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mt-2">
                                        @foreach (var s in m.Skills.Take(3))
                                        {
                                            <span class="badge bg-light text-dark border small fw-normal">@s</span>
                                        }
                                        @if (m.Skills.Count > 3)
                                        {
                                            <span class="badge bg-light text-muted border small fw-normal">+@(m.Skills.Count - 3)</span>
                                        }
                                    </div>
                                }
                            }
                            else if (isFaculty)
                            {
                                <div class="mb-2">
                                    <div class="fw-semibold text-dark small">@(m.Designation ?? "Faculty Member")</div>
                                    @if (!string.IsNullOrEmpty(m.CabinNumber))
                                    {
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-door-open me-1"></i> Cabin: @m.CabinNumber
                                        </div>
                                    }
                                </div>
                                @if (m.AvailableOfficeHoursCount > 0)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            <i class="fa-solid fa-calendar-check me-1"></i> @m.AvailableOfficeHoursCount Open Office Hours
                                        </span>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Card Action Footer -->
                        <div class="pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <a asp-action="Profile" asp-route-id="@m.UserId" class="btn btn-outline-secondary btn-sm rounded-3">
                                <i class="fa-solid fa-id-card me-1"></i> Profile
                            </a>

                            <div class="d-flex gap-1">
                                @if (m.ConnectionState == DirectoryConnectionState.IsSelf)
                                {
                                    <span class="badge bg-light text-muted border p-2">You</span>
                                }
                                else if (m.ConnectionState == DirectoryConnectionState.Connected)
                                {
                                    <a asp-controller="Messages" asp-action="Index" asp-route-userId="@m.UserId"
                                       class="btn btn-primary btn-sm rounded-3">
                                        <i class="fa-solid fa-comment me-1"></i> Chat
                                    </a>
                                }
                                else if (m.ConnectionState == DirectoryConnectionState.PendingSent)
                                {
                                    <button class="btn btn-light btn-sm rounded-3 text-muted border" disabled>
                                        <i class="fa-solid fa-clock me-1"></i> Requested
                                    </button>
                                }
                                else if (m.ConnectionState == DirectoryConnectionState.PendingReceived)
                                {
                                    <a asp-controller="Network" asp-action="Index" class="btn btn-warning btn-sm text-dark rounded-3">
                                        <i class="fa-solid fa-user-clock me-1"></i> Respond
                                    </a>
                                }
                                else
                                {
                                    <form asp-controller="Network" asp-action="Send" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="receiverId" value="@m.UserId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-3">
                                            <i class="fa-solid fa-user-plus me-1"></i> Connect
                                        </button>
                                    </form>
                                }

                                @if (isFaculty)
                                {
                                    <a asp-controller="OfficeHours" asp-action="Index" asp-route-facultyId="@m.UserId"
                                       class="btn btn-outline-success btn-sm rounded-3" title="View & Book Office Hours">
                                        <i class="fa-solid fa-calendar-days"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .transition-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
