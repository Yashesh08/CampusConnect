@using Microsoft.AspNetCore.Identity
@using CampusConnect.Models
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - CampusConnect" : "CampusConnect - Academic & Student Platform")</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome 6 Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- CampusConnect Custom Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Glassmorphism Top Navigation (Shared UI Shell) -->
    <nav class="navbar navbar-expand-lg cc-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-graduation-cap text-primary"></i> CampusConnect
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ccNavbar" aria-controls="ccNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ccNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 align-items-center">
                    <!-- 1. Home -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>

                    <!-- 2. Opportunities Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-briefcase me-1"></i> Opportunities
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-3">
                            <li>
                                <a class="dropdown-item" asp-controller="Opportunities" asp-action="Index">
                                    <i class="fa-solid fa-list-check text-primary me-2"></i> Browse Opportunities
                                </a>
                            </li>
                            @if (User.IsInRole("Student"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Applications" asp-action="MyApplications">
                                        <i class="fa-solid fa-paper-plane text-success me-2"></i> My Applications
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Faculty") || User.IsInRole("ClubCoordinator") || User.IsInRole("EventOrganizer") || User.IsInRole("Hod") || User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header small text-muted text-uppercase">Organizer Suite</li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Opportunities" asp-action="Create">
                                        <i class="fa-solid fa-plus text-primary me-2"></i> Post Opportunity
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Organizer" asp-action="Dashboard">
                                        <i class="fa-solid fa-chart-line text-info me-2"></i> Organizer Dashboard
                                    </a>
                                </li>
                                @if (User.IsInRole("Hod") || User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Opportunities" asp-action="PendingApprovals">
                                            <i class="fa-solid fa-check-double text-success me-2"></i> Admin Approvals
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </li>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- 3. Community & Networking Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-user-group me-1"></i> Community
                            </a>
                            <ul class="dropdown-menu shadow border-0 rounded-3">
                                <li>
                                    <a class="dropdown-item" asp-controller="Directory" asp-action="Index">
                                        <i class="fa-solid fa-address-book text-primary me-2"></i> Campus Directory
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Network" asp-action="Index">
                                        <i class="fa-solid fa-users text-success me-2"></i> My Network
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Messages" asp-action="Index">
                                        <i class="fa-solid fa-comments text-info me-2"></i> Direct Messages
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Announcements" asp-action="Index">
                                        <i class="fa-solid fa-bullhorn text-warning me-2"></i> Notices & Circulars
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 4. Academics Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-graduation-cap me-1"></i> Academics
                            </a>
                            <ul class="dropdown-menu shadow border-0 rounded-3">
                                <li>
                                    <a class="dropdown-item" asp-controller="OfficeHours" asp-action="Index">
                                        <i class="fa-solid fa-calendar-check text-success me-2"></i> Faculty Office Hours
                                    </a>
                                </li>
                                @if (User.IsInRole("Faculty") || User.IsInRole("Hod") || User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="OfficeHours" asp-action="Manage">
                                            <i class="fa-solid fa-calendar-plus text-primary me-2"></i> Manage Office Hours
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Hod") || User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header small text-muted text-uppercase">Academic Admin</li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Departments" asp-action="Index">
                                            <i class="fa-solid fa-building-columns text-primary me-2"></i> Departments
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Skills" asp-action="Index">
                                            <i class="fa-solid fa-lightbulb text-warning me-2"></i> Skills Registry
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>

                        <!-- 5. Grievances Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-flag me-1"></i> Grievances
                            </a>
                            <ul class="dropdown-menu shadow border-0 rounded-3">
                                <li>
                                    <a class="dropdown-item" asp-controller="Grievances" asp-action="Index">
                                        <i class="fa-solid fa-list text-primary me-2"></i> All Grievances
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Grievances" asp-action="Tracker">
                                        <i class="fa-solid fa-route text-success me-2"></i> Student Tracker
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Grievances" asp-action="Create">
                                        <i class="fa-solid fa-plus text-secondary me-2"></i> Submit Grievance
                                    </a>
                                </li>
                                @if (User.IsInRole("Faculty") || User.IsInRole("Hod") || User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Grievances" asp-action="OfficerDashboard">
                                            <i class="fa-solid fa-briefcase text-info me-2"></i> Officer Desk
                                        </a>
                                    </li>
                                }
                                @if (User.IsInRole("Hod") || User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Grievances" asp-action="Escalations">
                                            <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> HOD Escalations
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto align-items-center flex-row gap-2">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var roleName = currentUser?.Role.ToString() ?? "User";
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-1 rounded-pill pe-2 bg-light border" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar-sm bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </span>
                                <span class="d-none d-sm-inline fw-semibold text-dark small" style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@User.Identity.Name</span>
                                <span class="cc-badge cc-badge-purple user-role-badge">@roleName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                                <li class="dropdown-header">
                                    <small class="text-muted">Signed in as</small>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">@User.Identity.Name</div>
                                    <span class="badge bg-secondary mt-1">@roleName</span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="DashboardRouter">
                                        <i class="fa-solid fa-user me-2 text-primary"></i> My Profile / Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="TestEngine">
                                        <i class="fa-solid fa-sliders me-2 text-primary"></i> Skill Match Simulator
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" id="logoutForm">
                                        <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i> Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>

                        <!-- Dedicated Visible Log Out Button -->
                        <li class="nav-item">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 d-flex align-items-center gap-1 shadow-sm" title="Sign out of CampusConnect">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span class="d-none d-md-inline">Log Out</span>
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="cc-btn cc-btn-outline" asp-area="Identity" asp-page="/Account/Login">
                                <i class="fa-solid fa-right-to-bracket"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="cc-btn" asp-area="Identity" asp-page="/Account/Register">
                                <i class="fa-solid fa-user-plus"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main role="main" class="container" style="padding-top: 5.5rem; padding-bottom: 3rem;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Shared Modern Footer -->
    <footer class="cc-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-graduation-cap text-primary"></i> CampusConnect
                    </h5>
                    <p class="small text-muted mb-3">
                        Empowering academic collaboration, grievance management, student profiles, and opportunity skill matching across campus.
                    </p>
                    <div class="d-flex align-items-center gap-2">
                        <span class="cc-badge cc-badge-success">
                            <i class="fa-solid fa-circle-dot"></i> Systems Operational
                        </span>
                        <span class="small text-muted">v1.0.0</span>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5>Navigation</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li><a asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
                        <li><a asp-controller="Applications" asp-action="MyApplications">My Applications</a></li>
                        <li><a asp-controller="Organizer" asp-action="Dashboard">Organizer Dashboard</a></li>
                        <li><a asp-controller="Departments" asp-action="Index">Departments</a></li>
                    </ul>
                </div>
                <div class="col-lg-5 col-md-6">
                    <h5>Local Test Credentials</h5>
                    <p class="small text-muted mb-2">Default Password: <code class="text-warning fw-bold">Password123!</code></p>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-1">
                        <li><code class="text-light">admin@@campusconnect.edu</code> (Role: Admin)</li>
                        <li><code class="text-light">faculty.smith@@campusconnect.edu</code> (Role: Faculty - CSE)</li>
                        <li><code class="text-light">student.alice@@campusconnect.edu</code> (Role: Student - Roll CS202401)</li>
                    </ul>
                </div>
            </div>
            <hr class="cc-footer-divider" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 small text-muted">
                <div>&copy; @DateTime.UtcNow.Year CampusConnect Platform. All rights reserved.</div>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted">Privacy Policy</a>
                    <a href="#" class="text-muted">Terms of Service</a>
                    <a href="#" class="text-muted">Help & Support</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Prevent browser bfcache (Back/Forward Cache) showing stale login/logout state -->
    <script>
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.reload();
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
