@model CampusConnect.Models.User
@{
    ViewData["Title"] = "HOD Dashboard";
    var pendingCount = ViewBag.PendingOpportunitiesCount ?? 0;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Head of Department Dashboard</h2>
            <p class="text-muted">Welcome to the administrative portal, @Model.Email!</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-warning">
                <div class="card-body">
                    <h5 class="card-title text-muted fw-bold text-uppercase mb-3">Pending Approvals</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="fw-bold text-dark mb-0">@pendingCount</h2>
                        <i class="fa-solid fa-file-signature fa-2x text-warning opacity-50"></i>
                    </div>
                    <a asp-controller="Opportunities" asp-action="PendingApprovals" class="btn btn-outline-warning btn-sm mt-3 w-100">Review Now</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <h5 class="card-title text-muted fw-bold text-uppercase mb-3">Academic Departments</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <i class="fa-solid fa-building-columns fa-2x text-primary opacity-50"></i>
                    </div>
                    <a asp-controller="Departments" asp-action="Index" class="btn btn-outline-primary btn-sm mt-3 w-100">Manage Departments</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-start border-4 border-info">
                <div class="card-body">
                    <h5 class="card-title text-muted fw-bold text-uppercase mb-3">Skills Registry</h5>
                    <div class="d-flex justify-content-between align-items-center">
                        <i class="fa-solid fa-lightbulb fa-2x text-info opacity-50"></i>
                    </div>
                    <a asp-controller="Skills" asp-action="Index" class="btn btn-outline-info btn-sm mt-3 w-100">Manage Skills</a>
                </div>
            </div>
        </div>
    </div>
</div>
