@model List<CampusConnect.Models.SavedOpportunity>

@{
    ViewData["Title"] = "Saved Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">⭐ Saved Opportunities</h2>
        <p class="text-muted mb-0">Opportunities you have bookmarked for quick access.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to Opportunities</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 bg-light rounded-3 border">
        <h4 class="text-muted fw-normal">You haven't saved any opportunities yet.</h4>
        <p class="text-muted mb-3">Bookmark opportunities while browsing to keep track of deadlines.</p>
        <a asp-action="Index" class="btn btn-primary">Browse Opportunities</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            var opp = item.Opportunity;
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">@opp.Category</span>
                            <form method="post" asp-action="Unsave" asp-route-id="@opp.OpportunityId" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Bookmark">Remove</button>
                            </form>
                        </div>
                        <h5 class="card-title fw-bold text-dark mb-2">@opp.Title</h5>
                        <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @opp.Description
                        </p>

                        <div class="pt-3 border-top mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Saved on:</small>
                                <span class="fw-semibold text-dark small">@item.SavedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
