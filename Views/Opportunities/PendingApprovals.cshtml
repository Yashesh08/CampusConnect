@model IEnumerable<CampusConnect.Models.Opportunity>

@{
    ViewData["Title"] = "Pending Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Opportunity Approvals (Admin / HOD)</h2>
        <p class="text-muted mb-0">Review submitted opportunities before they are published to students.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5 bg-light rounded-3 border">
        <h4 class="text-muted fw-normal">No pending approvals!</h4>
        <p class="text-muted">All opportunity submissions have been reviewed.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Opportunity Title</th>
                        <th>Organizer</th>
                        <th>Category</th>
                        <th>Work Mode</th>
                        <th>Deadline</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var opp in Model)
                    {
                        <tr>
                            <td>
                                <strong>@opp.Title</strong>
                                <br />
                                <small class="text-muted">@(opp.TargetDepartment?.DepartmentName ?? "All Departments")</small>
                                <p class="small text-secondary mb-0 mt-1">@opp.Description</p>
                            </td>
                            <td>@(opp.Organizer?.Email ?? "Organizer")</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@opp.Category</span></td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@opp.WorkMode</span></td>
                            <td class="text-danger small fw-semibold">@opp.RegistrationDeadline.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-info">View Details</a>

                                    <form asp-action="Approve" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">Approve & Publish</button>
                                    </form>

                                    <form asp-action="Reject" asp-route-id="@opp.OpportunityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
