@model IEnumerable<CampusConnect.Models.Grievance>
@using CampusConnect.Models.Enums

@{
    ViewData["Title"] = "My Grievances";
    var departments = ViewBag.Departments as IEnumerable<CampusConnect.Models.Department> ?? new List<CampusConnect.Models.Department>();
    bool isPrivileged = ViewBag.IsPrivileged == true;
    var filterStatus = ViewBag.FilterStatus as GrievanceStatus?;
    var filterCategory = ViewBag.FilterCategory as GrievanceCategory?;
    var filterDeptId = ViewBag.FilterDeptId as int?;

    // Helper: badge color per status
    string StatusBadgeClass(GrievanceStatus s) => s switch
    {
        GrievanceStatus.Submitted    => "bg-secondary",
        GrievanceStatus.Acknowledged => "bg-info text-dark",
        GrievanceStatus.InProgress   => "bg-primary",
        GrievanceStatus.Escalated    => "bg-warning text-dark",
        GrievanceStatus.Resolved     => "bg-success",
        _                            => "bg-secondary"
    };

    string PriorityBadgeClass(GrievancePriority p) => p switch
    {
        GrievancePriority.Critical => "bg-danger",
        GrievancePriority.High     => "bg-orange-custom",
        GrievancePriority.Medium   => "bg-warning text-dark",
        GrievancePriority.Low      => "bg-success",
        _                          => "bg-secondary"
    };
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="fa-solid fa-flag-checkered text-primary me-2"></i>
            @(isPrivileged ? "All Grievances" : "My Grievances")
        </h1>
        <p class="text-muted mb-0">
            @if (isPrivileged)
            {
                <span>Manage and track all submitted campus grievances.</span>
            }
            else
            {
                <span>View and track your submitted grievance tickets.</span>
            }
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm px-4">
        <i class="fa-solid fa-plus me-2"></i> New Grievance
    </a>
</div>

<!-- Navigation Pills -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a asp-action="Index" class="nav-link active rounded-pill">
            <i class="fa-solid fa-list me-1"></i> @(isPrivileged ? "All Grievances" : "My Grievances")
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Tracker" class="nav-link bg-white text-dark shadow-sm rounded-pill">
            <i class="fa-solid fa-route me-1"></i> Student Tracker
        </a>
    </li>
    @if (ViewBag.IsOfficer == true)
    {
        <li class="nav-item">
            <a asp-action="OfficerDashboard" class="nav-link bg-white text-dark shadow-sm rounded-pill">
                <i class="fa-solid fa-briefcase me-1"></i> Officer Desk
            </a>
        </li>
    }
    @if (isPrivileged)
    {
        <li class="nav-item">
            <a asp-action="Escalations" class="nav-link bg-white text-danger shadow-sm rounded-pill">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> HOD Escalations
            </a>
        </li>
    }
</ul>

<!-- Filters (HOD/Admin only) -->
@if (isPrivileged)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Status</label>
                    <select name="status" class="form-select form-select-sm rounded-3">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<GrievanceStatus>())
                        {
                            if (filterStatus == s)
                            { <option value="@s" selected>@s</option> }
                            else
                            { <option value="@s">@s</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Category</label>
                    <select name="category" class="form-select form-select-sm rounded-3">
                        <option value="">All Categories</option>
                        @foreach (var c in Enum.GetValues<GrievanceCategory>())
                        {
                            if (filterCategory == c)
                            { <option value="@c" selected>@c</option> }
                            else
                            { <option value="@c">@c</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Department</label>
                    <select name="departmentId" class="form-select form-select-sm rounded-3">
                        <option value="">All Departments</option>
                        @foreach (var dept in departments)
                        {
                            if (filterDeptId == dept.DepartmentId)
                            { <option value="@dept.DepartmentId" selected>@dept.DepartmentCode</option> }
                            else
                            { <option value="@dept.DepartmentId">@dept.DepartmentCode</option> }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm rounded-3 flex-fill">
                        <i class="fa-solid fa-filter me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>
}

<!-- Stats row (HOD/Admin) -->
@if (isPrivileged && Model.Any())
{
    <div class="row g-3 mb-4">
        @{
            var total = Model.Count();
            var open = Model.Count(g => g.Status != GrievanceStatus.Resolved);
            var overdue = Model.Count(g => g.SlaDueAt.HasValue && g.SlaDueAt < DateTime.UtcNow && g.Status != GrievanceStatus.Resolved);
            var critical = Model.Count(g => g.Priority == GrievancePriority.Critical && g.Status != GrievanceStatus.Resolved);
        }
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);">
                <div class="card-body text-center py-3">
                    <div class="fs-2 fw-bold text-primary">@total</div>
                    <div class="small text-muted">Total</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#fff7ed,#fed7aa);">
                <div class="card-body text-center py-3">
                    <div class="fs-2 fw-bold" style="color:#ea580c;">@open</div>
                    <div class="small text-muted">Open</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#fef2f2,#fecaca);">
                <div class="card-body text-center py-3">
                    <div class="fs-2 fw-bold text-danger">@overdue</div>
                    <div class="small text-muted">SLA Overdue</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background:linear-gradient(135deg,#f5f3ff,#ede9fe);">
                <div class="card-body text-center py-3">
                    <div class="fs-2 fw-bold" style="color:#7c3aed;">@critical</div>
                    <div class="small text-muted">Critical Open</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Grievance List -->
@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body">
            <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>
            <h5 class="text-muted fw-semibold">No grievances found</h5>
            <p class="text-muted small mb-4">
                @(isPrivileged ? "No grievances match the current filters." : "You haven't submitted any grievances yet.")
            </p>
            <a asp-action="Create" class="btn btn-primary rounded-3 px-4">
                <i class="fa-solid fa-plus me-2"></i> Submit a Grievance
            </a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var g in Model)
        {
            bool isOverdue = g.SlaDueAt.HasValue && g.SlaDueAt < DateTime.UtcNow && g.Status != GrievanceStatus.Resolved;
            <div class="card border-0 shadow-sm rounded-4 grievance-card @(isOverdue ? "border-start border-4 border-danger" : "")">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <!-- Row 1: ticket id + badges -->
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="badge bg-light text-dark border fw-semibold" style="font-family:monospace;">
                                    #@g.GrievanceId.ToString()[..8].ToUpper()
                                </span>
                                <span class="badge rounded-pill @StatusBadgeClass(g.Status)">@g.Status</span>
                                <span class="badge rounded-pill @PriorityBadgeClass(g.Priority)">@g.Priority</span>
                                @if (g.IsAnonymous)
                                {
                                    <span class="badge rounded-pill bg-dark">
                                        <i class="fa-solid fa-user-secret me-1"></i>Anonymous
                                    </span>
                                }
                                @if (isOverdue)
                                {
                                    <span class="badge rounded-pill bg-danger">
                                        <i class="fa-solid fa-clock me-1"></i>SLA Overdue
                                    </span>
                                }
                            </div>

                            <!-- Row 2: category + dept -->
                            <div class="mb-2">
                                <span class="fw-semibold text-dark">@g.Category</span>
                                <span class="text-muted mx-1">·</span>
                                <span class="text-muted small">@g.Department?.DepartmentName</span>
                            </div>

                            <!-- Row 3: description snippet -->
                            <p class="text-muted small mb-2 lh-sm" style="max-width:680px;">
                                @(g.Description.Length > 160 ? g.Description[..160] + "…" : g.Description)
                            </p>

                            <!-- Row 4: meta -->
                            <div class="d-flex flex-wrap gap-3 small text-muted">
                                <span>
                                    <i class="fa-regular fa-calendar me-1"></i>
                                    Submitted @g.CreatedAt.ToString("MMM dd, yyyy")
                                </span>
                                @if (g.SlaDueAt.HasValue)
                                {
                                    <span class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                        <i class="fa-solid fa-hourglass-half me-1"></i>
                                        SLA due @g.SlaDueAt.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                @if (g.AssignedToUser != null)
                                {
                                    <span>
                                        <i class="fa-solid fa-user-check me-1"></i>
                                        Assigned to @g.AssignedToUser.Email
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <a asp-action="Details" asp-route-id="@g.GrievanceId"
                               class="btn btn-outline-primary btn-sm rounded-3 px-3">
                                <i class="fa-solid fa-eye me-1"></i> View
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .grievance-card { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .grievance-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.1) !important; }
    .bg-orange-custom { background-color: #ea580c !important; color: white !important; }
</style>
