@model CampusConnect.Models.ViewModels.GrievanceOfficerDashboardViewModel
@using CampusConnect.Models.Enums

@{
    ViewData["Title"] = "Officer Grievance Desk";

    string StatusBadgeClass(GrievanceStatus s) => s switch
    {
        GrievanceStatus.Submitted    => "bg-secondary text-white",
        GrievanceStatus.Acknowledged => "bg-info text-dark",
        GrievanceStatus.InProgress   => "bg-primary text-white",
        GrievanceStatus.Escalated    => "bg-danger text-white",
        GrievanceStatus.Resolved     => "bg-success text-white",
        _                            => "bg-secondary text-white"
    };

    string PriorityBadgeClass(GrievancePriority p) => p switch
    {
        GrievancePriority.Critical => "bg-danger text-white",
        GrievancePriority.High     => "bg-warning text-dark",
        GrievancePriority.Medium   => "bg-primary text-white",
        GrievancePriority.Low      => "bg-secondary text-white",
        _                          => "bg-secondary text-white"
    };
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="fw-bold mb-1">
            <i class="fa-solid fa-briefcase text-primary me-2"></i> Officer Grievance Desk
        </h1>
        <p class="text-muted mb-0">Manage your assigned investigation queue, execute workflow transitions, and resolve tickets within SLA targets.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="fa-solid fa-list me-1"></i> All Grievances
        </a>
        @if (User.IsInRole("Hod") || User.IsInRole("Admin"))
        {
            <a asp-action="Escalations" class="btn btn-danger rounded-3 shadow-sm">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> Escalations View
            </a>
        }
    </div>
</div>

<!-- Workload Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 text-center">
                <div class="fs-2 fw-bold text-primary">@Model.TotalAssigned</div>
                <div class="text-muted small fw-semibold">Total Assigned</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 text-center">
                <div class="fs-2 fw-bold text-info">@Model.AcknowledgedCount</div>
                <div class="text-muted small fw-semibold">Acknowledged</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 text-center">
                <div class="fs-2 fw-bold text-primary">@Model.InProgressCount</div>
                <div class="text-muted small fw-semibold">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white @(Model.OverdueCount > 0 ? "border-start border-4 border-danger" : "")">
            <div class="card-body p-3 text-center">
                <div class="fs-2 fw-bold @(Model.OverdueCount > 0 ? "text-danger" : "text-success")">@Model.OverdueCount</div>
                <div class="text-muted small fw-semibold">SLA Overdue</div>
            </div>
        </div>
    </div>
</div>

<!-- Status Filter Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a asp-action="OfficerDashboard" class="nav-link rounded-pill @(!Model.FilterStatus.HasValue ? "active" : "bg-white text-dark shadow-sm")">
            All Assigned (@Model.TotalAssigned)
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="OfficerDashboard" asp-route-status="@GrievanceStatus.Acknowledged"
           class="nav-link rounded-pill @(Model.FilterStatus == GrievanceStatus.Acknowledged ? "active" : "bg-white text-dark shadow-sm")">
            Acknowledged (@Model.AcknowledgedCount)
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="OfficerDashboard" asp-route-status="@GrievanceStatus.InProgress"
           class="nav-link rounded-pill @(Model.FilterStatus == GrievanceStatus.InProgress ? "active" : "bg-white text-dark shadow-sm")">
            In Progress (@Model.InProgressCount)
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="OfficerDashboard" asp-route-status="@GrievanceStatus.Resolved"
           class="nav-link rounded-pill @(Model.FilterStatus == GrievanceStatus.Resolved ? "active" : "bg-white text-dark shadow-sm")">
            Resolved (@Model.ResolvedCount)
        </a>
    </li>
</ul>

<!-- Assigned Tickets Table / Cards -->
<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
        <h5 class="fw-bold mb-0">
            <i class="fa-solid fa-list-check text-primary me-2"></i> Assigned Investigation Queue
        </h5>
    </div>
    <div class="card-body p-4">
        @if (!Model.AssignedGrievances.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-clipboard-check fa-3x text-muted mb-3 opacity-50"></i>
                <h5 class="fw-bold">No Grievances in this Queue</h5>
                <p class="text-muted small mb-0">You have no tickets currently matching this filter.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var g in Model.AssignedGrievances)
                {
                    bool isOverdue = g.SlaDueAt.HasValue && g.SlaDueAt < DateTime.UtcNow && g.Status != GrievanceStatus.Resolved;
                    <div class="card border-0 bg-light rounded-4 p-3 transition-hover @(isOverdue ? "border-start border-4 border-danger" : "")">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <code class="fw-bold fs-6 text-primary">#@g.GrievanceId.ToString()[..8].ToUpper()</code>
                                    <span class="badge rounded-pill @StatusBadgeClass(g.Status)">@g.Status</span>
                                    <span class="badge rounded-pill @PriorityBadgeClass(g.Priority)">@g.Priority Priority</span>
                                    @if (g.IsAnonymous)
                                    {
                                        <span class="badge rounded-pill bg-dark text-white">
                                            <i class="fa-solid fa-user-secret me-1"></i> Anonymous
                                        </span>
                                    }
                                    @if (isOverdue)
                                    {
                                        <span class="badge rounded-pill bg-danger text-white">
                                            <i class="fa-solid fa-clock me-1"></i> SLA Overdue
                                        </span>
                                    }
                                </div>

                                <h6 class="fw-bold text-dark mb-1">@g.Category</h6>
                                <p class="text-muted small mb-2" style="max-width: 650px;">
                                    @(g.Description.Length > 150 ? g.Description[..150] + "…" : g.Description)
                                </p>

                                <div class="d-flex flex-wrap gap-3 small text-muted">
                                    <span>
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        Submitted @g.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                    @if (g.SlaDueAt.HasValue)
                                    {
                                        <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                            <i class="fa-solid fa-hourglass-half me-1"></i>
                                            Target: @g.SlaDueAt.Value.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                    <span>
                                        <i class="fa-solid fa-building me-1"></i>
                                        @(g.Department?.DepartmentCode ?? "GEN")
                                    </span>
                                </div>
                            </div>

                            <!-- Fast Action Controls -->
                            <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
                                @if (g.Status == GrievanceStatus.Submitted)
                                {
                                    <form asp-action="UpdateStatus" asp-route-id="@g.GrievanceId" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newStatus" value="@GrievanceStatus.Acknowledged" />
                                        <input type="hidden" name="note" value="Acknowledged ticket and initiated preliminary review." />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-info btn-sm text-dark rounded-3 px-3">
                                            <i class="fa-solid fa-check me-1"></i> Acknowledge
                                        </button>
                                    </form>
                                }

                                @if (g.Status == GrievanceStatus.Acknowledged)
                                {
                                    <form asp-action="UpdateStatus" asp-route-id="@g.GrievanceId" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="newStatus" value="@GrievanceStatus.InProgress" />
                                        <input type="hidden" name="note" value="Officer commenced active resolution process." />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-primary btn-sm rounded-3 px-3">
                                            <i class="fa-solid fa-play me-1"></i> Start Work
                                        </button>
                                    </form>
                                }

                                @if (g.Status == GrievanceStatus.InProgress || g.Status == GrievanceStatus.Escalated)
                                {
                                    <button type="button" class="btn btn-success btn-sm rounded-3 px-3"
                                            data-bs-toggle="collapse" data-bs-target="#resolveBox-@g.GrievanceId">
                                        <i class="fa-solid fa-circle-check me-1"></i> Resolve…
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3"
                                            data-bs-toggle="collapse" data-bs-target="#escalateBox-@g.GrievanceId">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Escalate…
                                    </button>
                                }

                                <a asp-action="Details" asp-route-id="@g.GrievanceId" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
                                    <i class="fa-solid fa-eye me-1"></i> Details
                                </a>
                            </div>
                        </div>

                        <!-- Collapse Resolve Box -->
                        <div class="collapse mt-3" id="resolveBox-@g.GrievanceId">
                            <div class="p-3 bg-white rounded-3 border">
                                <form asp-action="UpdateStatus" asp-route-id="@g.GrievanceId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="newStatus" value="@GrievanceStatus.Resolved" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Resolution Notes for Ticket #@g.GrievanceId.ToString()[..8].ToUpper() <span class="text-danger">*</span></label>
                                        <textarea name="note" class="form-control form-control-sm" rows="2" required placeholder="Detail the resolution or corrective action implemented…"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-success btn-sm rounded-3">Confirm and Close Ticket</button>
                                </form>
                            </div>
                        </div>

                        <!-- Collapse Escalate Box -->
                        <div class="collapse mt-3" id="escalateBox-@g.GrievanceId">
                            <div class="p-3 bg-white rounded-3 border">
                                <form asp-action="UpdateStatus" asp-route-id="@g.GrievanceId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="newStatus" value="@GrievanceStatus.Escalated" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <div class="mb-2">
                                        <label class="form-label small fw-semibold">Escalation Reason <span class="text-danger">*</span></label>
                                        <textarea name="note" class="form-control form-control-sm" rows="2" required placeholder="Specify blocker, overdue cause, or reason for HOD intervention…"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-danger btn-sm rounded-3">Escalate to HOD</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Unassigned Pool for Self-Assignment -->
@if (Model.UnassignedDepartmentGrievances.Any())
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fa-solid fa-inbox text-warning me-2"></i> Unassigned Grievance Pool
                </h5>
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@Model.UnassignedDepartmentGrievances.Count Available</span>
            </div>
            <p class="text-muted small mb-0 mt-1">Claim any unassigned ticket to become its handling officer.</p>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Ticket</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Department</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var un in Model.UnassignedDepartmentGrievances)
                        {
                            <tr>
                                <td>
                                    <code class="fw-bold text-primary">#@un.GrievanceId.ToString()[..8].ToUpper()</code>
                                </td>
                                <td>@un.Category</td>
                                <td><span class="badge @PriorityBadgeClass(un.Priority)">@un.Priority</span></td>
                                <td>@(un.Department?.DepartmentCode ?? "GEN")</td>
                                <td class="small text-muted">@un.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <form asp-action="Assign" asp-route-id="@un.GrievanceId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assignedToUserId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
                                        <input type="hidden" name="note" value="Officer claimed unassigned grievance." />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm rounded-3">
                                            <i class="fa-solid fa-hand-holding-hand me-1"></i> Claim Ticket
                                        </button>
                                    </form>
                                    <a asp-action="Details" asp-route-id="@un.GrievanceId" class="btn btn-link btn-sm text-secondary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    .transition-hover {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .transition-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    }
</style>
