@model CampusConnect.Models.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    var completionScore = ViewBag.CompletionScore ?? 0;
}

<!-- Page Header -->
<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="cc-badge cc-badge-purple">
                    <i class="fa-solid fa-user-pen"></i> Profile Credentials
                </span>
                <span class="text-muted small">• FR-2 Profile Setup</span>
            </div>
            <h2 class="fw-bold mb-0">Update Student Profile</h2>
            <p class="text-muted mb-0">Keep your academic standing, portfolio links, and resume up-to-date.</p>
        </div>
        <div>
            <a asp-action="Dashboard" class="cc-btn cc-btn-outline">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="cc-card">
            <div class="cc-card-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="cc-card-title">
                        <i class="fa-solid fa-id-card text-primary me-2"></i> Profile Information
                    </h5>
                </div>
                <div class="text-end">
                    <span class="cc-badge @(completionScore >= 80 ? "cc-badge-success" : (completionScore >= 50 ? "cc-badge-warning" : "cc-badge-danger"))">
                        Completion: @completionScore%
                    </span>
                </div>
            </div>
            <div class="cc-card-body">
                <div class="progress-gradient mb-4" style="height: 8px;">
                    <div class="progress-bar" role="progressbar" style="width: @completionScore%" aria-valuenow="@completionScore" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                    <input type="hidden" asp-for="ProfileId" />
                    <input type="hidden" asp-for="ExistingResumeUrl" />
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="RollNumber" class="cc-form-label">University Roll Number</label>
                            <input asp-for="RollNumber" class="form-control" placeholder="e.g. CS202401" />
                            <span asp-validation-for="RollNumber" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="BatchYear" class="cc-form-label">Batch Graduation Year</label>
                            <input asp-for="BatchYear" class="form-control" placeholder="e.g. 2026" />
                            <span asp-validation-for="BatchYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="DepartmentId" class="cc-form-label">Academic Department</label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="@(ViewBag.Departments as SelectList)">
                                <option value="">-- Select Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Bio" class="cc-form-label">Bio & Interests</label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell organizers and faculty about your interests, domains, and goals..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GitHubUrl" class="cc-form-label">GitHub Profile URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-brands fa-github"></i></span>
                                <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/username" />
                            </div>
                            <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="LinkedInUrl" class="cc-form-label">LinkedIn Profile URL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-brands fa-linkedin text-primary"></i></span>
                                <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/username" />
                            </div>
                            <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ResumeFile" class="cc-form-label">Upload Resume Document</label>
                            <input asp-for="ResumeFile" class="form-control" type="file" accept=".pdf,.doc,.docx" />
                            @if (!string.IsNullOrEmpty(Model.ExistingResumeUrl))
                            {
                                <div class="mt-2 small text-muted">
                                    <i class="fa-solid fa-file-pdf text-danger me-1"></i> Current Resume: 
                                    <a href="@Model.ExistingResumeUrl" target="_blank" class="fw-semibold">View Uploaded PDF</a>
                                </div>
                            }
                            <small class="text-muted d-block mt-1">Accepted formats: PDF or DOCX (Max 5MB).</small>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-action="Dashboard" class="cc-btn cc-btn-outline">Cancel</a>
                        <button type="submit" class="cc-btn px-4">
                            <i class="fa-solid fa-check me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
