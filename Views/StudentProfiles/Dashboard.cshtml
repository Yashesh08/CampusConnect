@model CampusConnect.Models.StudentProfile
@using CampusConnect.Models.ViewModels

@{
    ViewData["Title"] = "Student Dashboard";
    var matches = ViewBag.Matches as List<DashboardOpportunityMatch>;
    var hasSkills = Model.StudentSkills != null && Model.StudentSkills.Any();
}

<!-- Welcome Header -->
<div class="mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="cc-badge cc-badge-purple">
                    <i class="fa-solid fa-graduation-cap"></i> Student Portal
                </span>
                <span class="text-muted small">• @User.Identity?.Name</span>
            </div>
            <h2 class="fw-bold mb-0">Student Dashboard</h2>
            <p class="text-muted mb-0">Track your academic profile completion, skill inventory, and algorithm-matched opportunities.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" class="cc-btn cc-btn-outline">
                <i class="fa-solid fa-user-pen"></i> Edit Profile
            </a>
            <a asp-action="ManageSkills" class="cc-btn">
                <i class="fa-solid fa-brain"></i> Manage Skills
            </a>
        </div>
    </div>
</div>

<!-- Profile Info Bar -->
<div class="p-3 bg-white rounded-3 border mb-4 shadow-sm">
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 52px; height: 52px;">
                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "S")
            </div>
        </div>
        <div class="col">
            <h5 class="fw-bold mb-0 text-dark">@User.Identity?.Name</h5>
            <div class="d-flex flex-wrap gap-2 text-muted small mt-1">
                <span><i class="fa-solid fa-id-badge text-primary me-1"></i> Roll: <strong>@(string.IsNullOrEmpty(Model.RollNumber) ? "Pending" : Model.RollNumber)</strong></span>
                <span>•</span>
                <span><i class="fa-solid fa-building-columns text-primary me-1"></i> Department: <strong>@(Model.Department?.DepartmentName ?? "Not Selected")</strong></span>
                <span>•</span>
                <span><i class="fa-solid fa-calendar-days text-primary me-1"></i> Batch: <strong>@(Model.BatchYear > 0 ? Model.BatchYear.ToString() : "N/A")</strong></span>
            </div>
        </div>
        <div class="col-auto d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model.GitHubUrl))
            {
                <a href="@Model.GitHubUrl" target="_blank" class="btn btn-sm btn-outline-dark rounded-circle" title="GitHub Profile">
                    <i class="fa-brands fa-github"></i>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
            {
                <a href="@Model.LinkedInUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-circle" title="LinkedIn Profile">
                    <i class="fa-brands fa-linkedin"></i>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.ResumeUrl))
            {
                <a href="@Model.ResumeUrl" target="_blank" class="btn btn-sm btn-outline-danger rounded-3" title="View Resume">
                    <i class="fa-solid fa-file-pdf me-1"></i> Resume
                </a>
            }
        </div>
    </div>
</div>

<!-- Top Section: Profile Completion & Skills Overview -->
<div class="row g-4 mb-4">
    <!-- Profile Completion Card -->
    <div class="col-lg-4">
        <div class="cc-card h-100">
            <div class="cc-card-header">
                <h5 class="cc-card-title">
                    <i class="fa-solid fa-chart-pie text-primary me-2"></i> Profile Completion
                </h5>
                <span class="cc-badge @(Model.ProfileCompletionScore >= 80 ? "cc-badge-success" : (Model.ProfileCompletionScore >= 50 ? "cc-badge-warning" : "cc-badge-danger"))">
                    @(Model.ProfileCompletionScore >= 80 ? "Almost Done" : "In Progress")
                </span>
            </div>
            <div class="cc-card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="match-score-display text-primary" style="font-size: 3rem;">
                        @Model.ProfileCompletionScore<span class="fs-4 text-muted">%</span>
                    </div>
                    <div class="text-end">
                        <small class="text-muted d-block">Completion Score</small>
                        <span class="badge bg-light text-dark border">5 Steps Total</span>
                    </div>
                </div>

                <div class="progress-gradient mb-4">
                    <div class="progress-bar" role="progressbar" style="width: @Model.ProfileCompletionScore%" aria-valuenow="@Model.ProfileCompletionScore" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <!-- Step Checklist -->
                <div class="list-group list-group-flush small">
                    <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid @(!string.IsNullOrEmpty(Model.RollNumber) ? "fa-circle-check text-success" : "fa-circle-xmark text-muted") me-2"></i> Roll Number</span>
                        <span class="badge @(!string.IsNullOrEmpty(Model.RollNumber) ? "bg-success-subtle text-success" : "bg-light text-muted")">@(!string.IsNullOrEmpty(Model.RollNumber) ? "Set" : "Pending")</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid @(Model.DepartmentId > 0 ? "fa-circle-check text-success" : "fa-circle-xmark text-muted") me-2"></i> Department Assigned</span>
                        <span class="badge @(Model.DepartmentId > 0 ? "bg-success-subtle text-success" : "bg-light text-muted")">@(Model.DepartmentId > 0 ? "Set" : "Pending")</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid @(!string.IsNullOrEmpty(Model.Bio) ? "fa-circle-check text-success" : "fa-circle-xmark text-muted") me-2"></i> Bio Summary</span>
                        <span class="badge @(!string.IsNullOrEmpty(Model.Bio) ? "bg-success-subtle text-success" : "bg-light text-muted")">@(!string.IsNullOrEmpty(Model.Bio) ? "Set" : "Pending")</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid @(!string.IsNullOrEmpty(Model.GitHubUrl) || !string.IsNullOrEmpty(Model.LinkedInUrl) ? "fa-circle-check text-success" : "fa-circle-xmark text-muted") me-2"></i> Portfolio & Social Links</span>
                        <span class="badge @(!string.IsNullOrEmpty(Model.GitHubUrl) || !string.IsNullOrEmpty(Model.LinkedInUrl) ? "bg-success-subtle text-success" : "bg-light text-muted")">@(!string.IsNullOrEmpty(Model.GitHubUrl) || !string.IsNullOrEmpty(Model.LinkedInUrl) ? "Set" : "Pending")</span>
                    </div>
                    <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid @(!string.IsNullOrEmpty(Model.ResumeUrl) ? "fa-circle-check text-success" : "fa-circle-xmark text-muted") me-2"></i> Resume Document</span>
                        <span class="badge @(!string.IsNullOrEmpty(Model.ResumeUrl) ? "bg-success-subtle text-success" : "bg-light text-muted")">@(!string.IsNullOrEmpty(Model.ResumeUrl) ? "Uploaded" : "Pending")</span>
                    </div>
                </div>
            </div>
            <div class="cc-card-footer">
                <a asp-action="Edit" class="cc-btn cc-btn-outline w-100">
                    <i class="fa-solid fa-pencil"></i> Update Profile Credentials
                </a>
            </div>
        </div>
    </div>

    <!-- Skills Inventory Card -->
    <div class="col-lg-8">
        <div class="cc-card h-100">
            <div class="cc-card-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="cc-card-title">
                        <i class="fa-solid fa-brain text-purple me-2"></i> Your Skills Inventory
                    </h5>
                    @if (hasSkills)
                    {
                        <span class="cc-badge cc-badge-purple">@Model.StudentSkills.Count Skill@(Model.StudentSkills.Count > 1 ? "s" : "")</span>
                    }
                </div>
                <a asp-action="ManageSkills" class="cc-btn cc-btn-outline py-1 px-3 fs-6">
                    <i class="fa-solid fa-plus me-1"></i> Add / Edit Skills
                </a>
            </div>
            <div class="cc-card-body d-flex flex-column">
                @if (hasSkills)
                {
                    <p class="text-muted small mb-3">
                        These skills are actively indexed by the CampusConnect algorithm to match you against relevant campus opportunities.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        @foreach (var studentSkill in Model.StudentSkills)
                        {
                            var prof = studentSkill.ProficiencyLevel.ToString().ToLower();
                            <div class="skill-chip">
                                <span class="fw-semibold">@studentSkill.Skill.SkillName</span>
                                <span class="proficiency-pill @prof">
                                    @if (prof == "advanced")
                                    {
                                        <i class="fa-solid fa-star me-1 text-warning"></i>
                                    }
                                    @studentSkill.ProficiencyLevel
                                </span>
                            </div>
                        }
                    </div>

                    <div class="mt-auto p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-lightbulb text-warning fa-lg"></i>
                            <span class="small text-muted">Want to see how your skills compare to a real listing?</span>
                        </div>
                        <a asp-controller="Home" asp-action="TestEngine" class="cc-btn cc-btn-secondary btn-sm">
                            <i class="fa-solid fa-sliders me-1"></i> Run Skill Simulator
                        </a>
                    </div>
                }
                else
                {
                    <div class="empty-state-box my-auto">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-lightbulb"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No Skills Added Yet</h5>
                        <p class="text-muted small mb-4" style="max-width: 440px; margin: 0 auto;">
                            Add your programming languages, tools, frameworks, and soft skills so the matching engine can recommend the best opportunities for you!
                        </p>
                        <a asp-action="ManageSkills" class="cc-btn">
                            <i class="fa-solid fa-plus me-1"></i> Add Your First Skill Now
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recommended Opportunities Section -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Recommended Opportunities</h4>
        <p class="text-muted small mb-0">Listings ranked by compatibility score calculated from your registered skills.</p>
    </div>
    <a asp-controller="Opportunities" asp-action="Index" class="cc-btn cc-btn-outline py-1 px-3">
        Explore All Listings <i class="fa-solid fa-arrow-right ms-1"></i>
    </a>
</div>

<div class="row g-4">
    @if (matches != null && matches.Any())
    {
        @foreach (var match in matches)
        {
            var pct = match.MatchResult.MatchPercentage;
            var badgeClass = pct >= 80 ? "cc-badge-success" : (pct >= 50 ? "cc-badge-warning" : "cc-badge-danger");
            var iconClass = pct >= 80 ? "fa-circle-check" : (pct >= 50 ? "fa-chart-pie" : "fa-circle-exclamation");

            <div class="col-md-6 col-lg-4">
                <div class="cc-card h-100">
                    <div class="cc-card-header">
                        <span class="cc-badge cc-badge-purple">@match.Opportunity.Category</span>
                        <span class="cc-badge @badgeClass">
                            <i class="fa-solid @iconClass"></i> @pct% Match
                        </span>
                    </div>
                    <div class="cc-card-body d-flex flex-column">
                        <h5 class="fw-bold text-dark mb-2">@match.Opportunity.Title</h5>
                        <p class="text-muted small mb-3 flex-grow-1">
                            @(match.Opportunity.Description.Length > 110 ? match.Opportunity.Description.Substring(0, 110) + "…" : match.Opportunity.Description)
                        </p>

                        <!-- Missing Skills Highlight -->
                        @if (match.MatchResult.MissingSkills.Any())
                        {
                            <div class="p-2 bg-light rounded-3 border mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <small class="fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Missing Skills:</small>
                                    <small class="text-muted">Gap</small>
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var gap in match.MatchResult.MissingSkills.Take(3))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 0.725rem;">
                                            @gap.SkillName
                                        </span>
                                    }
                                    @if (match.MatchResult.MissingSkills.Count > 3)
                                    {
                                        <span class="badge bg-light text-muted border" style="font-size: 0.725rem;">+@(match.MatchResult.MissingSkills.Count - 3) more</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-2 bg-success-subtle text-success rounded-3 border border-success-subtle mb-3 small fw-semibold">
                                <i class="fa-solid fa-check-double me-1"></i> You possess 100% of required skills!
                            </div>
                        }

                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@match.Opportunity.OpportunityId" class="cc-btn cc-btn-outline w-100 mt-auto">
                            View Opportunity Details <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state-box">
                <div class="empty-state-icon">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No Recommended Opportunities Yet</h5>
                <p class="text-muted small mb-3">
                    Check back soon as new campus workshops, internships, and hackathons get published!
                </p>
                <a asp-controller="Opportunities" asp-action="Index" class="cc-btn">
                    Browse All Opportunities
                </a>
            </div>
        </div>
    }
</div>
