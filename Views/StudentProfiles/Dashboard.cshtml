@model CampusConnect.Models.StudentProfile
@using CampusConnect.Models.ViewModels

@{
    ViewData["Title"] = "Student Dashboard";
    var matches = ViewBag.Matches as List<DashboardOpportunityMatch>;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Student Dashboard</h2>
            <p class="text-muted">Welcome back! Here's a snapshot of your profile and recommended opportunities.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card-page h-100">
                <h5>Profile Completion</h5>
                <div class="d-flex align-items-center mb-3 mt-4">
                    <div class="me-3">
                        <div class="display-5 fw-bold text-primary">@Model.ProfileCompletionScore%</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.ProfileCompletionScore%" aria-valuenow="@Model.ProfileCompletionScore" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
                <p class="text-muted small">Complete your profile to increase your chances of being matched with the best opportunities!</p>
                <a asp-action="Edit" class="btn btn-outline-primary btn-sm mt-auto">Update Profile</a>
                <a asp-action="ManageSkills" class="btn btn-outline-secondary btn-sm mt-auto ms-2">Manage Skills</a>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card-page h-100">
                <h5>Your Skills Overview</h5>
                @if (Model.StudentSkills != null && Model.StudentSkills.Any())
                {
                    <div class="mt-3">
                        @foreach (var studentSkill in Model.StudentSkills)
                        {
                            <span class="badge bg-secondary me-2 mb-2 p-2">
                                @studentSkill.Skill.SkillName 
                                <span class="badge bg-light text-dark ms-1">@studentSkill.ProficiencyLevel</span>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mt-3">You haven't added any skills yet. Add some to start seeing matches!</p>
                    <a asp-action="ManageSkills" class="btn btn-primary btn-sm mt-2">Add Skills Now</a>
                }
            </div>
        </div>
    </div>

    <h4 class="fw-bold mb-3">Recommended Opportunities</h4>
    <div class="row">
        @if (matches != null && matches.Any())
        {
            @foreach (var match in matches)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-primary">@match.Opportunity.Category</span>
                                <span class="badge bg-@(match.MatchResult.MatchPercentage >= 80 ? "success" : (match.MatchResult.MatchPercentage >= 50 ? "warning" : "danger"))">
                                    @match.MatchResult.MatchPercentage% Match
                                </span>
                            </div>
                            <h5 class="card-title fw-bold">@match.Opportunity.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(match.Opportunity.Description.Length > 100 ? match.Opportunity.Description.Substring(0, 100) + "..." : match.Opportunity.Description)
                            </p>
                            
                            @if (match.MatchResult.MissingSkills.Any())
                            {
                                <div class="mb-3">
                                    <small class="fw-bold text-danger">Missing Skills:</small><br />
                                    @foreach (var gap in match.MatchResult.MissingSkills.Take(3))
                                    {
                                        <span class="badge bg-light text-danger border border-danger me-1">@gap.SkillName</span>
                                    }
                                    @if(match.MatchResult.MissingSkills.Count > 3)
                                    {
                                        <span class="badge bg-light text-muted border">+@(match.MatchResult.MissingSkills.Count - 3) more</span>
                                    }
                                </div>
                            }

                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@match.Opportunity.OpportunityId" class="btn btn-outline-primary w-100 mt-auto">View Details</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No upcoming opportunities found at the moment. Check back later!
                </div>
            </div>
        }
    </div>
</div>
