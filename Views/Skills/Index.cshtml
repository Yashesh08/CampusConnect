@{
    Layout = null;
}
@model List<CampusConnect.Models.Skill>
<h1>Skills</h1>
<a asp-action="Create">+ New Skill</a>
<table>
    <tr><th>Category</th><th>Name</th><th></th></tr>
@foreach(var s in Model) {
    <tr>
        <td>@s.Category</td>
        <td>@s.SkillName</td>
        <td>
            <a asp-action="Edit" asp-route-id="@s.SkillId">Edit</a> |
            <a asp-action="Delete" asp-route-id="@s.SkillId">Delete</a>
        </td>
    </tr>
}
</table>
